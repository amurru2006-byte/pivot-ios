diff --git a/AltStore/Operations/FetchProvisioningProfilesOperation.swift b/AltStore/Operations/FetchProvisioningProfilesOperation.swift
--- a/AltStore/Operations/FetchProvisioningProfilesOperation.swift
+++ b/AltStore/Operations/FetchProvisioningProfilesOperation.swift
@@ -58,6 +58,22 @@ class FetchProvisioningProfilesOperation: ResultOperation<[String: ALTProvisioningProfile]>, @unchecked Sendable
                 
                 let profile = try result.get()
                 
+                // Fail before installation if Apple did not grant the requested
+                // HealthKit capabilities. Never silently strip them or bypass
+                // the existing signer/profile entitlement intersection.
+                let healthKitKeys = ["com.apple.developer.healthkit", "com.apple.developer.healthkit.background-delivery"]
+                for key in healthKitKeys
+                {
+                    let entitlement = ALTEntitlement(rawValue: key)
+                    let requested = self.additionalEntitlements?[entitlement] ?? app.entitlements[entitlement]
+                    if requested as? Bool == true, profile.entitlements[entitlement] as? Bool != true
+                    {
+                        throw NSError(domain: "AltStoreHealthKitProfile", code: 1, userInfo: [
+                            NSLocalizedDescriptionKey: "Il profilo restituito da Apple non autorizza \(key). Installazione fermata prima di sostituire l'app esistente. La modifica sperimentale ad AltStore non è sufficiente con questo profilo."
+                        ])
+                    }
+                }
+
                 var profiles = [app.bundleIdentifier: profile]
                 var error: Error?
                 
